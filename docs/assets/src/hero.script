# README hero: edit sprout in every editor, then play it.
# Run with: glimmer --studio-script docs/assets/src/hero.script carts/sprout.glim
record docs/assets/hero.gif
mouse 140 70
wait 40
key ctrl+f
type camera()
key enter
key esc
key end
key enter
type circfill(p.x + 4, p.y - 3, 1, 17)
wait 50
shot @code
key alt+3
mouse 150 30 10
click 140 12
wait 20
click 89 117
mouse 40 76 12
click 20 76
mouse 70 76 10
click 80 76
wait 40
shot @sprites
key alt+4
wait 20
mouse 60 99 10
rclick 60 99
key a
drag 130 52 200 52 30
drag 200 52 200 76 15
wait 30
shot @map
key alt+6
wait 15
key space
wait 120
shot @music
key space
key ctrl+r
wait 30
hold right
wait 25
key z
wait 40
key z
wait 30
release right
wait 20
shot @game
wait 30
stoprecord
