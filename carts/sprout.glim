glimmer cart 1
[meta]
title = sprout
author = glimmer
spec = 1
[code]
-- sprout.glim: a tiny platformer used in the readme.
-- arrows move, z jumps, collect the stars.
\
function _init()
  -- grass tiles (sprites 64-115) are solid: flag 0
  for n = 64, 115 do fset(n, 0, true) end
  p = {x = 16, y = 96, dx = 0, dy = 0, frame = 1, flip = false}
  score = 0
  music(0)
end
\
-- is the map solid at pixel (x, y)?
function solid(x, y)
  return fget(mget(flr(x / 8), flr(y / 8)), 0)
end
\
function _update()
  if btn("left") then p.dx = p.dx - 0.4 p.flip = true end
  if btn("right") then p.dx = p.dx + 0.4 p.flip = false end
  p.dx = mid(-1.6, p.dx * 0.8, 1.6)
  p.dy = min(p.dy + 0.25, 3)
\
  local grounded = solid(p.x + 1, p.y + 8) or solid(p.x + 6, p.y + 8)
  if grounded and btnp("a") then
    p.dy = -3.6
    sfx(0)
  end
\
  -- move one axis at a time so we can slide along walls
  local nx = p.x + p.dx
  if not (solid(nx + 1, p.y + 1) or solid(nx + 6, p.y + 1) or solid(nx + 1, p.y + 7) or solid(nx + 6, p.y + 7)) then
    p.x = nx
  end
  local ny = p.y + p.dy
  if p.dy > 0 and (solid(p.x + 1, ny + 8) or solid(p.x + 6, ny + 8)) then
    ny = flr((ny + 8) / 8) * 8 - 8
    p.dy = 0
  end
  p.y = ny
\
  if abs(p.dx) > 0.2 and grounded then p.frame = 1 + flr(t() * 8) % 2 end
\
  -- stars live on map layer 1
  local cx, cy = flr((p.x + 4) / 8), flr((p.y + 4) / 8)
  if mget(cx, cy, 1) == 5 then
    mset(cx, cy, 0, 1)
    score = score + 1
    sfx(1)
  end
end
\
function _draw()
  cls(26)
  camera(mid(0, p.x - 124, 128), 0)
  map(0, 0, 0, 0, 48, 18)
  spr(p.frame, p.x, p.y, 1, 1, p.flip)
  camera()
  print("stars " .. score, 4, 4, 1)
end
