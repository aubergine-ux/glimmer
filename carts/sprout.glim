glimmer cart 1
[meta]
title = sprout
author = glimmer
spec = 1
[code]
-- sprout.glim: a platformer. arrows run, z jumps; collect every star.
-- stomp snails from above. shows: tile collision with sprite flags,
-- a camera that follows the player, and jumps that feel good (coyote
-- time, a jump buffer and variable height).
\
level_w = 96 * 8
\
function _init()
  -- grass tiles (sprites 64-115) are solid: flag 0
  for n = 64, 115 do fset(n, 0, true) end
  state = "title"
  music(0)
end
\
function start()
  -- the map is edited at runtime (stars get picked up), so restore it
  reload_map()
  p = {x = 16, y = 96, dx = 0, dy = 0, frame = 1, flip = false, coyote = 0, buffer = 0}
  stars_total, stars, deaths, frames = 0, 0, 0, 0
  snails = {}
  for y = 0, 17 do
    for x = 0, 95 do
      local t = mget(x, y, 1)
      if t == 4 then stars_total = stars_total + 1 end
      -- snail markers become snails; the marker itself is removed
      if t == 9 then
        add(snails, {x = x * 8, y = y * 8, dir = -1, alive = true, squish = 0})
        mset(x, y, 0, 1)
      end
    end
  end
  state = "play"
end
\
-- keep a copy of the starting map so a new game can put the stars back
function reload_map()
  if not map_copy then
    map_copy = {}
    for i = 0, 96 * 18 - 1 do map_copy[i] = mget(i % 96, flr(i / 96), 1) end
  end
  for i = 0, 96 * 18 - 1 do mset(i % 96, flr(i / 96), map_copy[i], 1) end
end
\
function solid(x, y)
  return fget(mget(flr(x / 8), flr(y / 8)), 0)
end
\
function on_ground(o)
  return solid(o.x + 1, o.y + 8) or solid(o.x + 6, o.y + 8)
end
\
function respawn()
  deaths = deaths + 1
  p.x, p.y, p.dx, p.dy = 16, 96, 0, 0
  sfx(5)
end
\
function update_player()
  if btn("left") then p.dx = p.dx - 0.35 p.flip = true end
  if btn("right") then p.dx = p.dx + 0.35 p.flip = false end
  p.dx = mid(-1.7, p.dx * 0.82, 1.7)
  p.dy = min(p.dy + 0.25, 3.5)
\
  -- coyote time: a few frames after running off a ledge still count as
  -- standing. the jump buffer remembers a press made just before landing.
  local grounded = on_ground(p)
  p.coyote = grounded and 6 or p.coyote - 1
  p.buffer = btnp("a") and 6 or p.buffer - 1
  if p.buffer > 0 and p.coyote > 0 then
    p.dy, p.buffer, p.coyote = -3.8, 0, 0
    sfx(0)
  end
  -- let go of jump early for a shorter hop
  if not btn("a") and p.dy < -1.5 then p.dy = -1.5 end
\
  -- move one axis at a time so we can slide along walls
  local nx = p.x + p.dx
  if not (solid(nx + 1, p.y + 1) or solid(nx + 6, p.y + 1) or solid(nx + 1, p.y + 7) or solid(nx + 6, p.y + 7)) then
    p.x = mid(0, nx, level_w - 8)
  else
    p.dx = 0
  end
  local ny = p.y + p.dy
  if p.dy > 0 and (solid(p.x + 1, ny + 8) or solid(p.x + 6, ny + 8)) then
    ny = flr((ny + 8) / 8) * 8 - 8
    p.dy = 0
  elseif p.dy < 0 and (solid(p.x + 1, ny) or solid(p.x + 6, ny)) then
    ny = flr(ny / 8) * 8 + 8
    p.dy = 0
  end
  p.y = ny
  if p.y > 150 then respawn() end
\
  if abs(p.dx) > 0.2 and grounded then p.frame = 1 + flr(frames / 6) % 2 end
\
  -- stars (sprite 4) live on map layer 1
  local cx, cy = flr((p.x + 4) / 8), flr((p.y + 4) / 8)
  if mget(cx, cy, 1) == 4 then
    mset(cx, cy, 0, 1)
    stars = stars + 1
    sfx(1)
    if stars == stars_total then
      state = "won"
      sfx(6)
    end
  end
end
\
function update_snails()
  for s in all(snails) do
    if s.alive then
      -- crawl until the next step would be a wall or a drop, then turn
      local ahead = s.x + (s.dir < 0 and -1 or 8)
      if solid(ahead, s.y + 4) or not solid(ahead, s.y + 9) then s.dir = -s.dir end
      s.x = s.x + s.dir * 0.3
      if abs(p.x - s.x) < 7 and abs(p.y - s.y) < 7 then
        -- landing on top squashes it; touching it any other way hurts
        if p.dy > 0 and p.y < s.y - 2 then
          s.alive, s.squish = false, 20
          p.dy = -2.8
          sfx(4)
        else
          respawn()
        end
      end
    elseif s.squish > 0 then
      s.squish = s.squish - 1
    end
  end
end
\
function _update()
  if state == "play" then
    frames = frames + 1
    update_player()
    update_snails()
  elseif btnp("a") then
    start()
  end
end
\
function _draw()
  cls(26)
  if state == "title" then
    map(0, 0, 0, 0, 32, 18)
    rectfill(64, 38, 192, 86, 1)
    rect(64, 38, 192, 86, 21)
    print("SPROUT", 116, 46, 21)
    print("arrows run   z jumps", 88, 60, 5)
    print("find every star", 98, 68, 17)
    if t() % 1 < 0.6 then print("press z", 114, 78, 31) end
    return
  end
\
  -- the camera follows the player but never shows past the level's ends
  local cam = mid(0, p.x - 124, level_w - 256)
  camera(cam, 0)
  map(0, 0, 0, 0, 96, 18)
  for s in all(snails) do
    if s.alive then
      spr(9 + flr(frames / 12) % 2, s.x, s.y, 1, 1, s.dir > 0)
    elseif s.squish > 0 then
      sspr(72, 0, 8, 8, s.x, s.y + 4, 8, 4)
    end
  end
  spr(p.frame, p.x, p.y, 1, 1, p.flip)
  camera()
\
  print("\134 " .. stars .. "/" .. stars_total, 4, 4, 1)
  print(flr(frames / 60) .. "s", 236, 4, 1)
  if state == "won" then
    rectfill(56, 46, 200, 90, 1)
    rect(56, 46, 200, 90, 17)
    print("every star found!", 94, 54, 17)
    print("time " .. flr(frames / 60) .. "s   falls " .. deaths, 84, 66, 5)
    print("z: play again", 102, 78, 6)
  end
end
