glimmer cart 1
[meta]
title = bloom
author = glimmer
spec = 1
[code]
-- bloom.glim: generative art. particles drift along an invisible flow
-- field and leave fading trails. z starts a new piece, x changes the
-- colors, arrows bend the field.
-- shows: drawing without cls, fading with a fill pattern, and shimmering
-- the whole frame with the screen palette.

themes = {
  {1, 2, 3, 4, 5, 31},          -- dusk
  {9, 10, 11, 12, 13, 18},      -- ember
  {23, 24, 25, 26, 31, 5},      -- tide
  {19, 20, 21, 22, 18, 31},     -- moss
  {29, 30, 12, 17, 18, 31},     -- bloom
}

function _init()
  theme = 5
  new_piece()
  music(0)
end

function new_piece()
  seed = flr(rnd(10000))
  srand(seed)
  -- the field is a sum of a few sine waves with random scales and phases
  waves = {}
  for i = 1, 3 do
    add(waves, {fx = rnd(0.012) + 0.003, fy = rnd(0.012) + 0.003, phase = rnd(1), weight = rnd(1) + 0.3})
  end
  particles = {}
  for i = 1, 300 do add(particles, spawn()) end
  bend_x, bend_y, frame = 0, 0, 0
  cls(0)
end

function spawn()
  return {x = rnd(256), y = rnd(144), life = 80 + rnd(160)}
end

-- a smooth height map made of a few sine waves
function height(x, y)
  local h = 0
  for w in all(waves) do
    h = h + sin(x * w.fx + w.phase + bend_x) * cos(y * w.fy - w.phase + bend_y + frame * 0.0003) * w.weight
  end
  return h
end

-- particles flow along the height map's contour lines (its gradient
-- turned 90 degrees). a flow like that never piles particles up in one
-- place, so the picture stays full.
function flow(x, y)
  local dx = height(x + 1, y) - height(x - 1, y)
  local dy = height(x, y + 1) - height(x, y - 1)
  local len = sqrt(dx * dx + dy * dy)
  if len < 0.00001 then return 0, 0 end
  return dy / len, -dx / len
end

function _update()
  frame = frame + 1
  if btnp("a") then new_piece() end
  if btnp("b") then theme = theme % #themes + 1 end
  if btn("left") then bend_x = bend_x - 0.003 end
  if btn("right") then bend_x = bend_x + 0.003 end
  if btn("up") then bend_y = bend_y - 0.003 end
  if btn("down") then bend_y = bend_y + 0.003 end

  for p in all(particles) do
    local vx, vy = flow(p.x, p.y)
    p.px, p.py = p.x, p.y
    p.x = p.x + vx * 0.9
    p.y = p.y + vy * 0.9
    p.life = p.life - 1
    if p.life <= 0 or p.x < 0 or p.x > 255 or p.y < 0 or p.y > 143 then
      local q = spawn()
      p.x, p.y, p.life, p.px, p.py = q.x, q.y, q.life, nil, nil
    end
  end
end

function _draw()
  -- no cls: instead, darken one pixel in every 4x4 block each frame, so
  -- trails fade slowly. in a fill pattern, set bits draw the alternate
  -- color (here: nothing), so every bit but one is set.
  fillp(0xffff ~ 1 << flr(rnd(16)), -1)
  rectfill(0, 0, 255, 143, 0)
  fillp()

  local ramp = themes[theme]
  for p in all(particles) do
    if p.px then
      -- color by how old the particle is: young ones glow brightest
      local k = mid(1, flr(p.life / 40) + 1, #ramp)
      line(p.px, p.py, p.x, p.y, ramp[k])
    end
  end

  -- shimmer: once in a while swap neighbouring ramp colors for the whole
  -- frame. the screen palette changes what is shown, not what is drawn.
  pal()
  if frame % 90 < 6 then
    for i = 1, #ramp - 1 do pal(ramp[i], ramp[i + 1], true) end
  end

  if frame < 180 then
    print("bloom  #" .. seed, 4, 4, 6)
    print("z new  x colors  arrows bend", 4, 136, 7)
  end
end
