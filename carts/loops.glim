glimmer cart 1
[meta]
title = loops
author = glimmer
spec = 1
[code]
-- loops.glim: a step sequencer. click cells to toggle notes, or move with
-- the arrows and press z. x pauses, q/w change tempo, s changes the sound.
-- shows: building sound effects at runtime with poke, mouse input,
-- and saving a pattern in persistent memory.

cols, rows = 16, 8
cell_w, cell_h = 12, 11
gx, gy = 34, 22               -- top-left of the grid

-- a pentatonic scale: any notes from it sound good together.
-- pitch 0 is C2; these run from high to low.
notes = {38, 36, 33, 31, 28, 26}
names = {"d5", "c5", "a4", "g4", "e4", "d4", "sn", "kk"}
row_colors = {29, 30, 12, 16, 17, 21, 25, 4}
waves = {{6, "sine"}, {1, "pulse"}, {3, "saw"}, {5, "organ"}, {7, "soft"}}

-- sound effect n lives at 0x18400 + n * 68: speed, loop start, loop end,
-- flags, then 32 steps of two bytes. a step packs
-- pitch | wave << 6 | volume << 10 | effect << 13.
function make_sfx(n, speed, steps)
  local a = 0x18400 + n * 68
  poke(a, speed, 0, 0, 0)
  for i = 0, 31 do
    local s = steps[i + 1] or {0, 0, 0, 0}
    poke2(a + 4 + i * 2, s[1] | s[2] << 6 | s[3] << 10 | s[4] << 13)
  end
end

function build_sounds()
  local w = waves[wave_index][1]
  for r = 1, 6 do
    -- one short note that fades out (effect 5)
    make_sfx(r, 3, {{notes[r], w, 5, 0}, {notes[r], w, 4, 5}})
  end
  -- snare: a burst of high noise; kick: a low triangle that drops in pitch
  make_sfx(7, 2, {{40, 4, 5, 5}})
  make_sfx(8, 3, {{18, 2, 7, 3}, {10, 2, 5, 5}})
end

function _init()
  grid = {}
  for c = 1, cols do grid[c] = {} end
  if not load_pattern() then
    -- something to start from: a little groove
    for c = 1, cols, 4 do grid[c][8] = true end
    for c = 5, cols, 8 do grid[c][7] = true end
    -- a phrase that climbs and falls: {column, row}
    for n in all({{1, 6}, {3, 4}, {5, 3}, {7, 2}, {9, 3}, {11, 4}, {13, 5}, {15, 4}}) do grid[n[1]][n[2]] = true end
  end
  wave_index, bpm, playing = 1, 120, true
  step, timer = 1, 0
  cx, cy = 1, 1
  rings = {}
  build_sounds()
end

-- the pattern fits in 8 persistent slots: two columns (16 bits) each,
-- small enough to store exactly in dset's 32-bit floats
function save_pattern()
  for slot = 0, 7 do
    local bits = 0
    for half = 0, 1 do
      local c = slot * 2 + half + 1
      for r = 1, rows do
        if grid[c][r] then bits = bits | 1 << (half * 8 + r - 1) end
      end
    end
    dset(slot, bits)
  end
  dset(8, 1)  -- marks that a pattern was saved
end

function load_pattern()
  if dget(8) ~= 1 then return false end
  for slot = 0, 7 do
    local bits = flr(dget(slot))
    for half = 0, 1 do
      local c = slot * 2 + half + 1
      for r = 1, rows do grid[c][r] = bits & 1 << (half * 8 + r - 1) ~= 0 end
    end
  end
  return true
end

function toggle(c, r, value)
  if value == nil then value = not grid[c][r] end
  if grid[c][r] ~= value then
    grid[c][r] = value
    save_pattern()
    -- hear the cell when you switch it on
    if value then sfx(r, 3) end
  end
end

function cell_at(x, y)
  local c, r = flr((x - gx) / cell_w) + 1, flr((y - gy) / cell_h) + 1
  if c >= 1 and c <= cols and r >= 1 and r <= rows then return c, r end
end

function _update()
  -- mouse: click toggles, dragging paints the same state
  local mx, my, mb = mouse()
  local c, r = cell_at(mx, my)
  if mb & 1 ~= 0 and c then
    if not painting then painting = not grid[c][r] end
    toggle(c, r, painting)
    cx, cy = c, r
  else
    painting = nil
  end

  -- keyboard and gamepad
  if btnp("left") then cx = (cx - 2) % cols + 1 end
  if btnp("right") then cx = cx % cols + 1 end
  if btnp("up") then cy = (cy - 2) % rows + 1 end
  if btnp("down") then cy = cy % rows + 1 end
  if btnp("a") then toggle(cx, cy) end
  if btnp("b") then playing = not playing end
  if btnp("l") then bpm = max(60, bpm - 10) end
  if btnp("r") then bpm = min(200, bpm + 10) end
  if btnp("y") then
    wave_index = wave_index % #waves + 1
    build_sounds()
  end

  -- a step is a sixteenth note: 60 frames per second, 4 steps per beat
  if playing then
    timer = timer + bpm * 4 / 3600
    if timer >= 1 then
      timer = timer - 1
      step = step % cols + 1
      -- four channels, so at most four sounds per step
      local channel = 0
      for r = 1, rows do
        if grid[step][r] and channel < 4 then
          sfx(r, channel)
          channel = channel + 1
          add(rings, {x = gx + (step - 0.5) * cell_w, y = gy + (r - 0.5) * cell_h, size = 2, c = row_colors[r]})
        end
      end
    end
  end

  for g in all(rings) do
    g.size = g.size + 0.8
    if g.size > 14 then del(rings, g) end
  end
end

function _draw()
  cls(1)
  print("LOOPS", 4, 4, 30)
  print(bpm .. " bpm", 40, 4, 17)
  print(waves[wave_index][2], 80, 4, 25)
  print(playing and "playing" or "paused", 216, 4, playing and 21 or 6)

  for r = 1, rows do
    print(names[r], gx - 12, gy + (r - 1) * cell_h + 3, row_colors[r])
    for c = 1, cols do
      local x, y = gx + (c - 1) * cell_w, gy + (r - 1) * cell_h
      local on = grid[c][r]
      -- every fourth column is a beat; shade it so the bar reads at a glance
      local off = (c - 1) % 4 == 0 and 2 or 8
      if c == step and playing then off = 3 end
      rectfill(x + 1, y + 1, x + cell_w - 2, y + cell_h - 2, on and row_colors[r] or off)
      if on and c == step then rectfill(x + 3, y + 3, x + cell_w - 4, y + cell_h - 4, 31) end
    end
  end

  for g in all(rings) do circ(g.x, g.y, g.size, g.size < 8 and g.c or 2) end

  -- cursor for keyboard and gamepad players
  local x, y = gx + (cx - 1) * cell_w, gy + (cy - 1) * cell_h
  rect(x, y, x + cell_w - 1, y + cell_h - 1, t() * 4 % 2 < 1 and 31 or 5)

  print("click or z toggles  x pause  q/w tempo  s sound", 4, 136, 7)
end
